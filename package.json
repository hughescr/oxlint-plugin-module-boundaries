{
  "name": "@hughescr/eslint-plugin-module-boundaries",
  "version": "0.9.0",
  "description": "ESLint rules for module boundary enforcement: no cross-module @internal imports, no @internal re-exports in barrels, no star re-exports from non-barrel files",
  "keywords": ["eslint", "eslintplugin", "eslint-plugin", "typescript", "module-boundaries", "internal", "barrel"],
  "license": "BSD-3-Clause",
  "author": "Craig Hughes <craig.npm@rungie.com>",
  "repository": { "type": "git", "url": "git://github.com/hughescr/eslint-plugin-module-boundaries.git" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist", "docs"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clones": "jscpd src/",
    "dead-code": "knip",
    "dead-code:fix": "knip --fix",
    "lint": "eslint --cache --format unix .",
    "lint:fix": "eslint --cache --fix --format overview .",
    "lint:overview": "eslint --cache --format overview .",
    "mutate": "tools/run-stryker.sh",
    "mutate:wait": "tools/run-stryker.sh --wait",
    "prepublishOnly": "bun run build",
    "test": "bun test ${CI:+--timeout 60}",
    "test:full": "bun run lint;bun run typecheck;bun run mutate",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "postversion": "git commit -m \"Bump package version to $npm_package_version\" package.json; git flow release start $npm_package_version; git flow release finish -m $npm_package_version $npm_package_version; git checkout develop; git merge main"
  },
  "peerDependencies": { "eslint": ">=10.0.0", "typescript": ">=5.0.0" },
  "dependencies": {
    "@typescript-eslint/utils": "^8.34.0",
    "picomatch": "^4.0.4"
  },
  "devDependencies": {
    "@hughescr/eslint-config-default": "^5.1.0",
    "@hughescr/stryker-bun-runner": "^1.2.1",
    "@stryker-mutator/api": "^9.6.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@types/bun": "^1.3.13",
    "@types/picomatch": "^4.0.3",
    "@typescript-eslint/parser": "^8.34.0",
    "eslint": "^10.2.1",
    "eslint-formatter-overview": "^2.0.0",
    "eslint-formatter-unix": "^9.0.1",
    "eslint-plugin-jest": "^29.15.2",
    "jscpd": "^4.0.9",
    "knip": "^6.6.2",
    "typescript": "^6.0.3"
  },
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=20.0.0" }
}
